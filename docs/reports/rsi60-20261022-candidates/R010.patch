+        marker = state.get('auto_evaluation')
+        if not isinstance(marker, dict) or marker.get('source_job_id') != source_job_id:
+            return False
+        if only_status and marker.get('status') not in only_status:
+            return False
+        if marker.get('status') == 'started' and status != 'started':
+            return False
+        marker.update(status=status, evaluation_job_id=evaluation_job_id,
+                      reason_code=reason_code,
+                      reason=reason or (_AUTO_REASONS.get(reason_code, '')[:300] or None),
+                      updated_at=time.time())
+        write_json(root / 'state.json', state)
+        return True
+
+
+def _schedule_auto_evaluation(sid, source_job_id):
+    """Attempt exactly one normal evaluation after durable work delivery."""
+    with locked(sid) as root:
+        state, _ = load_session(root)
+        marker = state.get('auto_evaluation')
+        if (not isinstance(marker, dict) or marker.get('source_job_id') != source_job_id
+                or marker.get('status') != 'requested'
+                or state.get('job_id') != source_job_id
+                or state.get('phase') != 'responded'
+                or not state.get('delivery')):
