+_AUTO_REASONS = {
+    'budget_exhausted': 'Automatic evaluation was blocked by the task budget; inspect usage before any further action.',
+    'budget_unknown': 'Automatic evaluation was blocked because budget usage is unknown; inspect accounting before any further action.',
+    'capacity': 'Automatic evaluation was blocked by executor/provider capacity.',
+    'concurrent_job': 'Automatic evaluation was skipped because another job was already running.',
+    'paused_or_cancelled': 'Automatic evaluation was skipped because continuation is paused or cancelled.',
+    'launch_failed': 'Automatic evaluation could not start its background process; inspect the task before retrying manually.',
+    'work_failed': 'Automatic evaluation was skipped because the work turn failed.',
+    'delivery_failed': 'Automatic evaluation was skipped because delivery was not completed.',
+    'admission_refused': 'Automatic evaluation was refused by normal admission; inspect status before any further action.',
