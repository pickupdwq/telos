+}
+
+
+def _auto_reason(error):
+    if isinstance(error, BudgetExceeded):
+        snapshot = error.snapshot if isinstance(error.snapshot, dict) else {}
+        state = (snapshot.get('budget_state') or {}).get('state')
+        code = 'budget_unknown' if state == 'unknown' else 'budget_exhausted'
+        return code, _AUTO_REASONS[code]
+    if isinstance(error, GateError):
+        code = getattr(error, 'code', None)
+        if code in ('continuation_stopped',):
+            return 'paused_or_cancelled', _AUTO_REASONS['paused_or_cancelled']
+        if code in ('job_running',):
+            return 'concurrent_job', _AUTO_REASONS['concurrent_job']
+        text = str(error).lower()
+        if 'concurrency limit' in text or code == 'capacity':
+            return 'capacity', _AUTO_REASONS['capacity']
+        if 'could not start' in text:
+            return 'launch_failed', _AUTO_REASONS['launch_failed']
+        if 'paused/cancelled' in text:
+            return 'paused_or_cancelled', _AUTO_REASONS['paused_or_cancelled']
+        return 'admission_refused', _AUTO_REASONS['admission_refused']
+    return 'internal_refusal', _AUTO_REASONS['internal_refusal']
+
+
+def _update_auto_evaluation(sid, source_job_id, status, reason_code=None,
+                            evaluation_job_id=None, only_status=None, reason=None):
+    with locked(sid) as root:
