+    """Reject invalid command operand counts before any handler can run."""
+    bounds = {
+        "serve": (0, 0), "doctor": (0, 0), "recover": (0, 0),
+        "auth": (1, 1), "status": (1, 2), "review": (1, 2),
+        "receive": (2, 3), "pause": (1, 1), "resume": (1, 1),
