+            ('cache', 'target', 'extra'), ('cache', '--action', 'archive'),
+            ('local',), ('local', 'list', 'extra'), ('local', 'add'),
+            ('local', 'add', 'name', 'extra'), ('local', 'select'),
+            ('_job', 'sid'), ('_job', 'sid', 'job', 'extra'),
