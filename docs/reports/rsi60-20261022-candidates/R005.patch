+class ExecutionPackageGuidanceTests(unittest.TestCase):
+    ADVISORY = (
+        'Execution package: before editing, map each requirement to its file/interface, dependencies, '
+        'edge cases and public test; keep this map in working context, not a new file. Batch independent '
+        'reads within scope. Implement related changes, run focused tests and repair coherently in this '
+        'turn; stop for a real blocker or budget limit. Final delivery must identify evidence, failures, '
+        'blockers and unfinished items. This grants no broader permissions or private acceptance access.'
+    )
+
+    def setUp(self):
+        self.state = {'worktree': '/worktree', 'base_commit': 'a' * 40}
+        self.evidence = {'status': 'passed', 'cwd': '/worktree', 'interpreter': '/verified/python'}
+
+    def test_implementation_guidance_has_one_exact_bounded_advisory_before_patch_block(self):
+        for contract in ({}, {'task_type': 'implementation'}):
+            with self.subTest(contract=contract):
+                text = executor._work_guidance(self.evidence, contract, self.state)
+                self.assertEqual(text.count(self.ADVISORY), 1)
+                self.assertLessEqual(len(self.ADVISORY), 600)
+                self.assertLess(text.index(self.ADVISORY), text.index('Patch format: apply_patch'))
+                guidance = text.split('Verified work guidance', 1)[1]
+                self.assertLessEqual(len(guidance), 2500)
+
+    def test_audit_modes_exclude_the_advisory_and_patch_block(self):
+        audit_contracts = (
+            {'task_type': 'audit', 'audit': {'targets': []}},
+            {'audit': {'targets': []}},
+        )
+        for contract in audit_contracts:
+            with self.subTest(contract=contract):
+                text = executor._work_guidance(self.evidence, contract, self.state,
+                                               artifact_root='/artifacts')
+                self.assertNotIn(self.ADVISORY, text)
+                self.assertNotIn('Patch format: apply_patch', text)
+
+    def test_legacy_audit_key_contract_without_artifact_root_excludes_the_advisory(self):
+        text = executor._work_guidance(
+            self.evidence, {'audit': {'targets': []}}, self.state)
+        self.assertNotIn(self.ADVISORY, text)
+        self.assertNotIn('Patch format: apply_patch', text)
+
+    def test_artifact_root_implementation_excludes_the_advisory(self):
+        text = executor._work_guidance(
+            self.evidence, {'task_type': 'implementation', 'audit': {'targets': []}}, self.state,
+            artifact_root='/artifacts')
+        self.assertNotIn(self.ADVISORY, text)
+        self.assertNotIn('Patch format: apply_patch', text)
+
+
